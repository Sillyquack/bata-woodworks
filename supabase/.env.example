# Local/sandbox defaults. Never use mock/log providers for live orders.
APP_ENV=local
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SITE_URL=http://127.0.0.1:5173
PRIVACY_VERSION=needs_owner
# Local mock tests exercise the offer path. Production must keep this false
# until ENK identity, VAT status and Norwegian consumer terms are approved.
LEGAL_TRADING_ENABLED=true
# Non-secret operating switch. Match the public VITE_REQUEST_INTAKE_OPEN value.
REQUEST_INTAKE_OPEN=true
RATE_LIMIT_SALT=generate-at-least-32-random-characters
CRON_SECRET=generate-at-least-32-random-characters
PAYMENT_RECONCILIATION_STALE_SECONDS=15
PAYMENT_RECONCILIATION_BATCH_SIZE=25

EMAIL_PROVIDER=log
EMAIL_FROM=Bata Woodworks <hello@batawoodworks.no>
INTERNAL_NOTIFICATION_EMAIL=robert@batawoodworks.no
# RESEND_API_KEY is required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=

PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS=true
MOCK_PAYMENT_SECRET=generate-at-least-32-random-characters

# Vipps MobilePay: required only when PAYMENT_PROVIDER=vipps.
VIPPS_ENVIRONMENT=test
VIPPS_LIVE_ENABLED=false
VIPPS_CARD_ENABLED=false
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MERCHANT_SERIAL_NUMBER=
VIPPS_WEBHOOK_SECRET=
