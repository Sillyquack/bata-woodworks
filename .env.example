# Set true for a backend-free public showroom. In that mode, leave all
# Supabase/privacy values below unset and keep every intake/trading/payment
# gate false or disabled.
VITE_SHOWROOM_ONLY=false

# Public browser configuration for a later backend-enabled deployment. A
# Supabase publishable key is designed for browser use; RLS and Edge Function
# authorization still enforce access.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Safe public operating switch. Set false and rebuild to keep the public site
# visible while disabling the request form. Match REQUEST_INTAKE_OPEN server-side.
VITE_REQUEST_INTAKE_OPEN=true

# Must exactly match the owner-approved version configured on the server.
VITE_PRIVACY_VERSION=needs_owner

# Server operating gates mirrored into the Pages validation job. These are
# not a substitute for matching secrets on a deployed backend.
LEGAL_TRADING_ENABLED=false
REQUEST_INTAKE_OPEN=false
PAYMENT_PROVIDER=disabled
VIPPS_LIVE_ENABLED=false
ALLOW_MOCK_PAYMENTS=false
