# Public browser configuration. A Supabase publishable key is designed for
# browser use; RLS and Edge Function authorization still enforce access.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Safe public operating switch. Set false and rebuild to keep the public site
# visible while disabling the request form. Match REQUEST_INTAKE_OPEN server-side.
VITE_REQUEST_INTAKE_OPEN=true

# Must exactly match the owner-approved version configured on the server.
VITE_PRIVACY_VERSION=needs_owner
